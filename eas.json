{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "",
        "EXPO_PUBLIC_CONVEX_SITE_URL": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "",
        "EXPO_PUBLIC_CONVEX_SITE_URL": ""
      }
    },
    "production-apk": {
      "channel": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "",
        "EXPO_PUBLIC_CONVEX_SITE_URL": "",
        "NODE_ENV": "production"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "",
        "EXPO_PUBLIC_CONVEX_SITE_URL": "",
        "NODE_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
