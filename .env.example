# ── Client-side (bundled into app) ──
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.eu-west-1.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.eu-west-1.convex.site
CONVEX_DEPLOYMENT=prod:your-deployment-name

# ── Sentry (crash reporting + performance monitoring) ──
EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Source map upload requires a Sentry auth token registered as an EAS secret:
#   eas secret:create --name SENTRY_AUTH_TOKEN --value <token>
# Get the token at: https://sentry.io/settings/account/api/auth-tokens/
# Without it, source maps will NOT upload and crash reports will stay minified.

# ── Convex Dashboard (npx convex env set KEY "value" --prod) ──
# BETTER_AUTH_SECRET     — openssl rand -base64 32
# GOOGLE_CLIENT_ID       — Google OAuth client ID
# GOOGLE_CLIENT_SECRET   — Google OAuth client secret
# SITE_URL               — Frontend URL (e.g. http://localhost:8081 for dev)
# R2_ENDPOINT            — Cloudflare R2 endpoint
# R2_ACCESS_KEY_ID       — R2 access key
# R2_SECRET_ACCESS_KEY   — R2 secret key
# R2_BUCKET_NAME         — R2 bucket name (e.g. zst-media)
# R2_PUBLIC_URL          — R2 public URL (e.g. https://pub-xxx.r2.dev)
